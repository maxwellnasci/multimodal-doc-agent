# Ambiente: "production" (padrão, se ausente) ou "development".
# Em produção o app NÃO sobe sem OPENROUTER_API_KEY e o mock fica desabilitado.
# Para rodar localmente sem chave (mock determinístico), use development.
DOC_AGENT_ENV=production

# Obrigatória em produção.
OPENROUTER_API_KEY=sk-or-...

# Opcional: modelos que a UI pode usar (separados por vírgula) e o padrão entre eles.
# DOC_AGENT_MODEL precisa estar na lista; sem a lista, só o modelo padrão é permitido.
# DOC_AGENT_ALLOWED_MODELS=nvidia/nemotron-3.5-super-vl
# DOC_AGENT_MODEL=nvidia/nemotron-3.5-super-vl
